{
    "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on",
                "useSortedAttributes": "on"
            }
        }
    },
    "files": {
        "includes": [
            "**",
            "!**/loader",
            "!**/package.json",
            "!**/package-lock.json",
            "!**/dist",
            "!**/www",
            "!**/src/components.d.ts",
            "!**/src/components/p-icon/icons.ts"
        ]
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "suspicious": {
                "noUnknownAtRules": "off"
            },
            "correctness": {
                "noUnknownTypeSelector": "off"
            },
            "a11y": {
                "noStaticElementInteractions": "off",
                "useKeyWithClickEvents": "off"
            },
            "style": {
                "noUnusedTemplateLiteral": "off",
                "noInferrableTypes": "off",
                "useConsistentMemberAccessibility": {
                    "level": "error",
                    "options": {
                        "accessibility": "explicit"
                    }
                }
            }
        }
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 140,
        "expand": "always"
    },
    "javascript": {
        "formatter": {
            "semicolons": "asNeeded",
            "quoteStyle": "single"
        }
    }
}
